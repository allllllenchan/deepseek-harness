# Pre-empt D3 (see UPGRADE-ENV-DEBT.md): pin registry to npmjs so any future
# `pnpm install` (e.g. on official upgrade) does not silently stall on
# registry.npmmirror.com tarball fetches (observed with libreoffice-kit-win32-x64).
# The lockfile (v9 format) embeds no registry URLs, so this file is the single
# effective control point.
registry=https://registry.npmjs.org/
